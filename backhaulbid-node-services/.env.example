# Legacy direct-run fallback for bidding-service & notification-service.
# Official shared runtime configuration is backhaulbid-infrastructure/.env
# and Docker Compose must be used for the integrated environment.

PORT=3001
NOTIFICATION_PORT=3002
MONGO_URI=mongodb://backhaulbid:change-me-mongodb-password@localhost:27017/backhaulbid_bidding?authSource=admin
REDIS_URL=redis://:change-me-redis-password@localhost:6379
RABBITMQ_URL=amqp://backhaulbid:change-me-rabbitmq-password@localhost:5672
IDENTITY_SERVICE_URL=http://localhost:8081
FLEET_SERVICE_URL=http://localhost:8082
WALLET_SERVICE_URL=http://localhost:8083
CONTRACT_SERVICE_URL=http://localhost:8084
MEDIA_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:3002
INTERNAL_WALLET_TOKEN=change-me-internal-wallet-token
INTERNAL_SERVICE_TOKEN=change-me-internal-wallet-token

SWAGGER_ENABLED=true
OPENAPI_GATEWAY_SERVER_URL=/api/v1/bidding
OPENAPI_DIRECT_SERVER_URL=http://localhost:3001
